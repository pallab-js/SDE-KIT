{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SDE Kit",
  "version": "0.1.0",
  "identifier": "com.sdekit.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w apps/desktop",
    "beforeBuildCommand": "npm run build -w apps/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "SDE Kit",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "frameworks": [],
      "signingIdentity": "Apple Development: Test Signer (ABC123XYZ)"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://localhost/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW51c2VkX3BsYWNlaG9sZGVyX3B1YmtleV9zb21lX3JhbmRvbV9iYXNlNjRfc3RyaW5n"
    }
  }
}

